APP_NAME=Bit_micro_serverse

SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Токен для межсервисных вызовов (internal API)
INTERNAL_API_TOKEN=change-me-internal-token

HEAD_REGISTER_PASSWORD=123456789

PASSWORD_RESET_CODE_TTL_MINUTES=15

# Порты сервисов (наружу)
AUTH_SERVICE_PORT=8001
PAYROLL_SERVICE_PORT=8002
DASHBOARD_SERVICE_PORT=8003
KP_SERVICE_PORT=8004

# Адреса сервисов внутри docker-сети
AUTH_SERVICE_URL=http://auth-service:8001
PAYROLL_SERVICE_URL=http://payroll-service:8002

# Экономика расчётов
OFFICE_COST_PER_EMPLOYEE=45000
INSURANCE_RATE_PERCENT=30
VAT_RATE_PERCENT=5
NDFL_RATE_PERCENT=13
FOT_MARGIN_NORMAL_PCT=20
FOT_MARGIN_CRITICAL_PCT=25

# PostgreSQL (у каждого сервиса своя БД)
POSTGRES_USER=bitserves
POSTGRES_PASSWORD=bitserves_password
POSTGRES_PORT=5432
POSTGRES_HOST_AUTH=db-auth
POSTGRES_DB_AUTH=auth_db
POSTGRES_HOST_PAYROLL=db-payroll
POSTGRES_DB_PAYROLL=payroll_db
POSTGRES_HOST_KP=db-kp
POSTGRES_DB_KP=kp_db
